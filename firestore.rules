rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(emailId) {
      return emailId is string
        && emailId.size() >= 3
        && emailId.size() <= 160
        && emailId.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'sabirismayil01@gmail.com';
    }

    function isAuthorizedStoreUser() {
      return isAdmin() || (
        isSignedIn()
        && request.auth.token.email_verified == true
        && ('email' in request.auth.token)
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email.lower()))
      );
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidNonNegativeNumber(val) {
      return (val is int || val is float) && val >= 0 && val <= 100000000;
    }

    function isValidPositiveNumber(val) {
      return (val is int || val is float) && val > 0 && val <= 100000000;
    }

    function isValidOptionalNonNegativeNumber(data, key) {
      return !(key in data) || isValidNonNegativeNumber(data[key]);
    }

    function isValidOptionalIcon(data) {
      return !('icon' in data) || (
        data.icon is string
        && data.icon.size() <= 40
        && data.icon in [
          'pen',
          'pencil',
          'notebook',
          'eraser',
          'marker',
          'ruler',
          'folder',
          'paper',
          'glue_tape',
          'scissors_stapler',
          'paint_brush',
          'stationery_default'
        ]
      );
    }

    // --- Validation Blueprints ---
    function isValidProduct(data) {
      return data.keys().hasAll([
          'name',
          'barcode',
          'barcodeFormat',
          'category',
          'quantity',
          'unit',
          'salePrice',
          'ownerId',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'name',
          'barcode',
          'barcodeFormat',
          'category',
          'brand',
          'quantity',
          'unit',
          'purchasePrice',
          'salePrice',
          'minStock',
          'shelfLocation',
          'notes',
          'icon',
          'ownerId',
          'createdAt',
          'updatedAt'
        ])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.barcode is string && data.barcode.size() >= 1 && data.barcode.size() <= 64
        && data.barcode.matches('^[A-Za-z0-9_\\-\\.\\/\\+:=\\?&%# ]+$')
        && data.barcodeFormat is string && data.barcodeFormat.size() >= 1 && data.barcodeFormat.size() <= 32
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && isValidOptionalString(data, 'brand', 80)
        && isValidNonNegativeNumber(data.quantity)
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 24
        && isValidOptionalNonNegativeNumber(data, 'purchasePrice')
        && isValidNonNegativeNumber(data.salePrice)
        && isValidOptionalNonNegativeNumber(data, 'minStock')
        && isValidOptionalString(data, 'shelfLocation', 64)
        && isValidOptionalString(data, 'notes', 500)
        && isValidOptionalIcon(data)
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'ownerId', 'createdAt'])
        && data.keys().hasOnly(['name', 'ownerId', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 64
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidSale(data) {
      return data.keys().hasAll([
          'productId',
          'productName',
          'barcode',
          'category',
          'quantity',
          'unit',
          'unitPrice',
          'totalAmount',
          'ownerId',
          'soldAt'
        ])
        && data.keys().hasOnly([
          'productId',
          'productName',
          'barcode',
          'category',
          'quantity',
          'unit',
          'unitPrice',
          'totalAmount',
          'discountAmount',
          'ownerId',
          'receiptNumber',
          'paymentMethod',
          'cashierEmail',
          'soldAt'
        ])
        && isValidId(data.productId)
        && data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 160
        && data.barcode is string && data.barcode.size() >= 1 && data.barcode.size() <= 64
        && data.barcode.matches('^[A-Za-z0-9_\\-\\.\\/\\+:=\\?&%# ]+$')
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 64
        && isValidPositiveNumber(data.quantity)
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 24
        && isValidNonNegativeNumber(data.unitPrice)
        && isValidNonNegativeNumber(data.totalAmount)
        && isValidOptionalNonNegativeNumber(data, 'discountAmount')
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && isValidOptionalString(data, 'receiptNumber', 40)
        && (!('paymentMethod' in data) || data.paymentMethod in ['cash', 'card', 'c2c', 'mobile'])
        && isValidOptionalString(data, 'cashierEmail', 160)
        && data.soldAt is timestamp;
    }

    function isValidAuthorizedUser(data) {
      return data.keys().hasAll(['email', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'label', 'addedBy', 'createdAt'])
        && isValidEmailId(data.email)
        && isValidOptionalString(data, 'label', 80)
        && data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128
        && data.addedBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidReceiptSettings(data) {
      return data.keys().hasAll(['storeName', 'paperWidth', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly([
          'storeName',
          'subtitle',
          'address',
          'phone',
          'taxId',
          'footerNote',
          'paperWidth',
          'updatedBy',
          'updatedAt'
        ])
        && data.storeName is string && data.storeName.size() >= 1 && data.storeName.size() <= 80
        && isValidOptionalString(data, 'subtitle', 100)
        && isValidOptionalString(data, 'address', 140)
        && isValidOptionalString(data, 'phone', 40)
        && isValidOptionalString(data, 'taxId', 40)
        && isValidOptionalString(data, 'footerNote', 160)
        && data.paperWidth in ['80mm', '58mm']
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp;
    }

    // --- Collection: /authorized_users/{emailId} ---
    match /authorized_users/{emailId} {
      // Users can check only their own email record; admin can read any
      allow get: if isAdmin() || (
        isSignedIn()
        && request.auth.token.email_verified == true
        && isValidEmailId(emailId)
        && emailId == request.auth.token.email.lower()
      );

      // Strictly restricted to admin to prevent PII enumeration
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidEmailId(emailId)
        && isValidAuthorizedUser(incoming())
        && incoming().email == emailId
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isAdmin()
        && isValidEmailId(emailId);
    }

    // --- Collection: /products/{productId} ---
    match /products/{productId} {
      allow get: if isAuthorizedStoreUser()
        && isValidId(productId);

      allow list: if isAuthorizedStoreUser();

      allow create: if isAuthorizedStoreUser()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAuthorizedStoreUser()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Quick stock quantity adjustment or sale deduction
          incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'updatedAt'])
          ||
          // Action 2: Full or partial product & barcode edit
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'barcode',
            'barcodeFormat',
            'category',
            'brand',
            'quantity',
            'unit',
            'purchasePrice',
            'salePrice',
            'minStock',
            'shelfLocation',
            'notes',
            'icon',
            'updatedAt'
          ])
        );

      allow delete: if isAuthorizedStoreUser()
        && isValidId(productId);
    }

    // --- Collection: /categories/{categoryId} ---
    match /categories/{categoryId} {
      allow get: if isAuthorizedStoreUser()
        && isValidId(categoryId);

      allow list: if isAuthorizedStoreUser();

      allow create: if isAuthorizedStoreUser()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if isAuthorizedStoreUser()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name']);

      allow delete: if isAuthorizedStoreUser()
        && isValidId(categoryId);
    }

    // --- Collection: /sales/{saleId} ---
    match /sales/{saleId} {
      allow get: if isAuthorizedStoreUser()
        && isValidId(saleId);

      allow list: if isAuthorizedStoreUser();

      allow create: if isAuthorizedStoreUser()
        && isValidId(saleId)
        && isValidSale(incoming())
        && incoming().soldAt == request.time
        && exists(/databases/$(database)/documents/products/$(incoming().productId))
        && getAfter(/databases/$(database)/documents/products/$(incoming().productId)).data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/products/$(incoming().productId)).data.quantity <= get(/databases/$(database)/documents/products/$(incoming().productId)).data.quantity;

      allow update: if false;

      allow delete: if isAuthorizedStoreUser()
        && isValidId(saleId);
    }

    // --- Collection: /store_settings/{settingId} ---
    match /store_settings/{settingId} {
      allow get: if isAuthorizedStoreUser()
        && settingId == 'receipt';

      allow list: if false;

      allow create: if isAuthorizedStoreUser()
        && settingId == 'receipt'
        && isValidReceiptSettings(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isAuthorizedStoreUser()
        && settingId == 'receipt'
        && isValidReceiptSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'storeName',
          'subtitle',
          'address',
          'phone',
          'taxId',
          'footerNote',
          'paperWidth',
          'updatedBy',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}
