{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Office supply store inventory product with barcode and stock tracking.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Product display name."
        },
        "barcode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_\\-\\.\\/\\+:=\\?&%# ]+$",
          "description": "Product barcode string scanned from camera, gallery image, or entered manually."
        },
        "barcodeFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Detected or manual barcode format (e.g. EAN_13, CODE_128, QR_CODE, MANUAL)."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Product category name."
        },
        "brand": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional brand or manufacturer name."
        },
        "quantity": {
          "type": "number",
          "description": "Current stock quantity (non-negative)."
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "Unit of measure (e.g. ədəd, qutu, paket, dəst, rulon)."
        },
        "purchasePrice": {
          "type": "number",
          "description": "Optional purchase price in AZN (non-negative)."
        },
        "salePrice": {
          "type": "number",
          "description": "Sale price in AZN (non-negative)."
        },
        "minStock": {
          "type": "number",
          "description": "Minimum stock alert threshold (non-negative)."
        },
        "shelfLocation": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional shelf or storage location label."
        },
        "notes": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional owner notes for this product."
        },
        "icon": {
          "type": "string",
          "maxLength": 40,
          "enum": [
            "pen",
            "pencil",
            "notebook",
            "eraser",
            "marker",
            "ruler",
            "folder",
            "paper",
            "glue_tape",
            "scissors_stapler",
            "paint_brush",
            "stationery_default"
          ],
          "description": "Optional stationery icon identifier displayed alongside the product."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the store owner."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "name",
        "barcode",
        "barcodeFormat",
        "category",
        "quantity",
        "unit",
        "salePrice",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Custom office supply category managed by the store owner.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Category label."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the store owner."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        }
      },
      "required": [
        "name",
        "ownerId",
        "createdAt"
      ]
    },
    "Sale": {
      "title": "Sale",
      "description": "Completed point-of-sale transaction deducting product stock.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Referenced product document ID."
        },
        "productName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Snapshot of product name at sale time."
        },
        "barcode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_\\-\\.\\/\\+:=\\?&%# ]+$",
          "description": "Snapshot of product barcode at sale time."
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Product category at sale time."
        },
        "quantity": {
          "type": "number",
          "description": "Sold quantity (strictly positive)."
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "Unit of measure."
        },
        "unitPrice": {
          "type": "number",
          "description": "Sale unit price in AZN."
        },
        "purchasePrice": {
          "type": "number",
          "description": "Optional snapshot of unit purchase cost in AZN at sale time (non-negative)."
        },
        "totalAmount": {
          "type": "number",
          "description": "Total transaction amount in AZN."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the store owner."
        },
        "receiptNumber": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional shared receipt number grouping items sold in one transaction."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "card", "c2c", "mobile"],
          "maxLength": 16,
          "description": "Optional payment method ('cash', 'card', 'c2c', or 'mobile')."
        },
        "discountAmount": {
          "type": "number",
          "description": "Optional non-negative discount amount applied to this sale line item in AZN."
        },
        "cashierEmail": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional email of the cashier who completed the sale."
        },
        "soldAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the sale."
        },
        "returnedQuantity": {
          "type": "number",
          "description": "Optional cumulative quantity returned from this sale line item (0 <= returnedQuantity <= quantity)."
        },
        "returnedAmount": {
          "type": "number",
          "description": "Optional cumulative refunded amount in AZN (0 <= returnedAmount <= totalAmount)."
        },
        "returnReason": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional reason or note for the product return."
        },
        "returnedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Optional server timestamp of the most recent return on this sale."
        }
      },
      "required": [
        "productId",
        "productName",
        "barcode",
        "category",
        "quantity",
        "unit",
        "unitPrice",
        "totalAmount",
        "ownerId",
        "soldAt"
      ]
    },
    "AuthorizedUser": {
      "title": "AuthorizedUser",
      "description": "Google account email allowlisted by the primary store owner to access the store.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$",
          "description": "Normalized lowercase Google account email."
        },
        "label": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional display label or note for the authorized person."
        },
        "addedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of the primary owner who added this account."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when access was granted."
        }
      },
      "required": [
        "email",
        "addedBy",
        "createdAt"
      ]
    },
    "ReceiptSettings": {
      "title": "ReceiptSettings",
      "description": "Thermal POS receipt header, contact details, and paper width configuration.",
      "type": "object",
      "properties": {
        "storeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Store display title printed at top of receipt."
        },
        "subtitle": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional store subtitle line."
        },
        "address": {
          "type": "string",
          "maxLength": 140,
          "description": "Optional store address."
        },
        "phone": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional contact phone number."
        },
        "taxId": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional VÖEN / tax identifier."
        },
        "footerNote": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional thank-you message at bottom of receipt."
        },
        "paperWidth": {
          "type": "string",
          "enum": ["80mm", "58mm"],
          "description": "Thermal printer paper width."
        },
        "templateId": {
          "type": "string",
          "enum": ["classic", "modern", "compact", "detailed"],
          "maxLength": 24,
          "description": "Selected receipt template layout."
        },
        "headerBadge": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional receipt header/footer document title badge."
        },
        "showBarcode": {
          "type": "boolean",
          "description": "Whether to render the verification barcode at the bottom of the receipt."
        },
        "showItemBarcodes": {
          "type": "boolean",
          "description": "Whether to show product barcodes under line items."
        },
        "showCashier": {
          "type": "boolean",
          "description": "Whether to display the cashier label on the receipt."
        },
        "showPaymentMethod": {
          "type": "boolean",
          "description": "Whether to display the payment method on the receipt."
        },
        "showTaxId": {
          "type": "boolean",
          "description": "Whether to display the store VÖEN when entered."
        },
        "fontScale": {
          "type": "string",
          "enum": ["compact", "normal", "large"],
          "maxLength": 16,
          "description": "Receipt font size scale."
        },
        "dividerStyle": {
          "type": "string",
          "enum": ["dashed", "solid", "double"],
          "maxLength": 16,
          "description": "Receipt section divider line style."
        },
        "showLogo": {
          "type": "boolean",
          "description": "Whether to display the selected store logo or uploaded image at the top of the receipt."
        },
        "logoPreset": {
          "type": "string",
          "enum": ["none", "stationery", "bag", "book", "star", "crown"],
          "maxLength": 24,
          "description": "Built-in geometric logo preset identifier."
        },
        "logoDataUrl": {
          "type": "string",
          "maxLength": 45000,
          "pattern": "^(|data:image\\/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+)$",
          "description": "Compressed custom store logo image data URL (PNG, JPEG, or WebP)."
        },
        "promoBanner": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional custom greeting or promotional message rendered at the bottom of the receipt."
        },
        "promoBannerUppercase": {
          "type": "boolean",
          "description": "Whether to transform promoBanner into uppercase letters using Azerbaijani locale."
        },
        "promoBannerStyle": {
          "type": "string",
          "enum": ["boxed", "inverted", "plain"],
          "maxLength": 16,
          "description": "Visual presentation style for the bottom greeting banner."
        },
        "lockEnabled": {
          "type": "boolean",
          "description": "Whether automatic idle screen lock is enabled."
        },
        "lockTimeoutSeconds": {
          "type": "number",
          "description": "Idle duration in seconds before locking the screen (0 to 86400)."
        },
        "lockPinHash": {
          "type": "string",
          "maxLength": 128,
          "description": "PBKDF2-SHA256 hex hash of the screen-lock PIN."
        },
        "lockPinSalt": {
          "type": "string",
          "maxLength": 64,
          "description": "Random hex salt used for the screen-lock PIN hash."
        },
        "lockPinLength": {
          "type": "number",
          "description": "Digit count of the configured PIN (4 to 6)."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UID of authorized user who updated settings."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "storeName",
        "paperWidth",
        "updatedBy",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Office supply store products isolated per authorized user via ownerId."
    },
    "/categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/Category"
      },
      "description": "Store product categories isolated per authorized user via ownerId."
    },
    "/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/Sale"
      },
      "description": "Completed sales records isolated per authorized user via ownerId."
    },
    "/authorized_users/{emailId}": {
      "schema": {
        "$ref": "#/entities/AuthorizedUser"
      },
      "description": "Allowlist of Google account emails permitted to sign in with their own isolated workspace."
    },
    "/store_settings/{userId}": {
      "schema": {
        "$ref": "#/entities/ReceiptSettings"
      },
      "description": "Per-user thermal receipt layout and store settings keyed by Firebase Auth UID."
    }
  }
}
